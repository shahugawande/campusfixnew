PORT=3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Admins need this code to create their own account
ADMIN_INVITE_CODE=CHANGE-THIS-STAFF-CODE
# Auto-creates the first admin if none exists
ADMIN_USER=admin
ADMIN_PASS=ChangeMe@123
# Free cloud database (turso.tech). Leave both empty to use a local file instead.
TURSO_URL=
TURSO_TOKEN=
